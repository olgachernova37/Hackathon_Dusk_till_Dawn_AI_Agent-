# =============================================================================
#  Human-Gated AI Copilot — environment
#  Copy to .env.local and fill in. See PLAN.md §4 for where each value comes from.
# =============================================================================

# --- World ID / Selfie Check -------------------------------------------------
# developer.worldcoin.org → create app → copy the app id (app_xxxxx)
NEXT_PUBLIC_WLD_APP_ID=app_
# The action you created in the Developer Portal
NEXT_PUBLIC_WLD_ACTION=human-gate
# "sandbox" for the Sandbox World App, "production" for the real one.
# Keep this on sandbox for the hackathon.
NEXT_PUBLIC_WLD_ENV=sandbox
# Relying-party id from the Developer Portal (rp_xxxxx)
WLD_RP_ID=rp_
# RP signing key — signs the RpContext server-side. NEVER expose to the client.
WLD_RP_PRIVATE_KEY=

# --- The Graph ---------------------------------------------------------------
# thegraph.com/studio/apikeys → connect wallet → Create API Key.
# One key serves both Gateway GraphQL and the Subgraph MCP server.
GRAPH_API_KEY=

# --- Bazantic ----------------------------------------------------------------
# No API key: x402 authenticates each call by payment.
# The x402/MPP Gateway URL Bazantic gives you after building the gateway
BAZANTIC_GATEWAY_URL=https://
# Path of the paid endpoint on that gateway, e.g. /assess
BAZANTIC_RECIPE_ENDPOINT=
# BURNER wallet private key (0x + 64 hex) that pays for x402 calls. Never a
# personal wallet. Pays USDC on Base mainnet (see src/lib/bazantic/x402.ts);
# fund it with ~$1 of USDC — no ETH needed, the facilitator pays gas.
X402_PRIVATE_KEY=
# Optional: base URL used in approval links. Defaults to the origin the
# request arrived on (e.g. https://echobrief.online), which is usually right.
# PUBLIC_BASE_URL=https://echobrief.online

# --- Agent -------------------------------------------------------------------
# Google AI Studio → Get API key (free tier is enough for the demo)
GEMINI_API_KEY=
# Optional. Any Gemini model with function calling.
GEMINI_MODEL=gemini-flash-lite-latest

# --- Marketplace judge (src/lib/market) ----------------------------------------
# The judge that checks a provider's delivery. Without a key every verdict is
# "uncertain" and goes to a human Selfie Check instead of paying out.
OPENAI_API_KEY=
# Optional. Any chat model that supports JSON output.
# OPENAI_MODEL=gpt-4o-mini
# Optional. Point demo providers at wallets you control. Before funding, each
# provider's wallet is checked on The Graph; the built-in placeholder addresses
# have no history, so every deal to them waits for a human Selfie Check.
# MARKET_PROVIDER_ADDRESSES={"lingo-fast":"0x…","lingo-pro":"0x…"}

# Apify Scout, the web_research provider, runs an Apify Actor with this token.
# An ordinary API token (console.apify.com → Settings → API & Integrations) or
# a prepaid token bought over x402 (docs.apify.com/integrations/x402) both work.
APIFY_TOKEN=
# Optional. Any Actor that takes {query, maxResults} and returns pages with URLs.
# APIFY_RESEARCH_ACTOR=apify/rag-web-browser

# Spoken alerts in the deal console. Without a key the browser's own voice is used.
ELEVENLABS_API_KEY=
# Optional. Defaults: a premade voice and ElevenLabs' default multilingual model.
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=

# --- Marketplace settlement (Base Sepolia testnet) ---------------------------
# With both keys set, escrow moves real testnet USDC:
#   lock: buyer → escrow · release: escrow → provider · refund: escrow → buyer.
# Use fresh hackathon-only wallets. Set these in the hosting dashboard only;
# never commit them. Without them every deal is labelled SIMULATED.
# Buyer needs Base Sepolia USDC (faucet.circle.com); both need a little ETH for gas.
MARKET_BUYER_PRIVATE_KEY=
MARKET_ESCROW_PRIVATE_KEY=
# Which testnet: base-sepolia (default) or sepolia (Ethereum Sepolia). The USDC
# and the gas ETH must be on this same network.
# MARKET_CHAIN=sepolia
# Optional RPC for that network (defaults: sepolia.base.org / publicnode).
# MARKET_RPC_URL=
# Hard caps enforced in code before any payment (defaults 5 and 10).
# MARKET_MAX_PAYMENT_USD=5
# MARKET_DAILY_CAP_USD=10
# "advisory" shows the provider's Graph evidence without gating on it — testnet
# wallets have no mainnet history, so "enforce" (default) would gate every deal.
# MARKET_GRAPH_GATE=advisory

# --- Storage (Redis) ---------------------------------------------------------
# REQUIRED on Vercel, optional locally. Add the Upstash Redis integration from
# the Vercel Marketplace and these are injected automatically (either naming
# scheme works). Leave unset locally to use the file store in .data/kv/.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Offline dev switches ----------------------------------------------------
# Set to 1 to run without live credentials. MUST stay off for the demo:
# The Graph prize explicitly disqualifies mocked data, and the UI shows a
# "MOCK DATA" badge whenever any of these is on.
MOCK_GRAPH=0
MOCK_WORLDID=0
MOCK_BAZANTIC=0
